<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>register</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <div class="card">
        <h1>Create Account</h1>
        <p class="subtitle">Register & Get Started</p>

        <% if(error){ %>
            <p class="error"><%= error %></p>
        <% } %>

        <form method="POST" enctype="multipart/form-data">
            <input type="text" name="fullname" placeholder="enter your fullname" required><br>
            <input type="email" name="email" placeholder="enter email" required><br>
            <input type="password" name="password" placeholder="password" minlength="8" required><br>
            <input type="file" name="profilePicture" accept="image/jpeg, image/png, image/jpg"><br>
            <button type="submit">login</button>
        </form>
        <p class="switch">Already have an account? <a href="/">login here</a></p>
    </div>
</body>
</html>